<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/PawnKindDef[defName="CFAR_FusilierHptm"]/apparelRequired/li[4]</xpath>
					<value>
						<li>Apparel_PackBroadshield</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/QuestScriptDef[defName="Util_ChooseRandomQuestHelperKind"]/root/nodes/li[1]/choices</xpath>
					<value>
						<li>
							<factionDef>CFAR_Kaiserinreich</factionDef>
							<pawnKinds>
								<li>CFAR_FusilierAssault</li>
								<li>CFAR_FusilierHeavy</li>
							</pawnKinds>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/QuestScriptDef[defName="Util_ChooseRandomQuestLodgerKind"]/root/nodes/li[1]/node/choices</xpath>
					<value>
						<li>
							<factionDef>CFAR_Kaiserinreich</factionDef>
							<pawnKinds>
								<li>CFAR_FusilierLtn</li>
								<li>CFAR_FusilierHptm</li>
							</pawnKinds>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>