<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!--================ Industrial Apparel ================-->

<!--======== Reichswehr Uniforms ========-->

	<ThingDef ParentName="ApparelMakeableBase">
		<techLevel>Industrial</techLevel>
		<defName>Apparel_CFAR_UniformField</defName>
		<label>Arellian field uniform</label>
		<description>WIP</description>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
			<displayPriority>1172</displayPriority>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Pawn/Arellian/Apparel/UniformShirt/Apparel</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<costStuffCount>50</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<thingCategories>
			<li>ApparelMisc</li>
		</thingCategories>
		<statBases>
			<WorkToMake>3000</WorkToMake>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>0.4</Mass>
			<StuffEffectMultiplierArmor>0.20</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<Terror MayRequire="Ludeon.RimWorld.Ideology">1</Terror>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
			<PainShockThreshold>0.1</PainShockThreshold>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Arellian/Apparel/UniformShirt/Apparel</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags>
				<li>CFAR_Uniform</li>
			</tags>
			<defaultOutfitTags>
				<li>CFAR_Trooper</li>
				<li>CFAR_Soldier</li>
				<li>CFAR_Officer</li>
				<li>CFAR_Commander</li>
			</defaultOutfitTags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li><only>(255,255,255)</only></li>
			</options>
		</colorGenerator>
		<tradeTags>
			<li>BasicClothing</li>
			<li>CFAR_Apparel</li>
		</tradeTags>
	</ThingDef>

