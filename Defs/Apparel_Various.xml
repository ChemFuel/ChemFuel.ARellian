				<li>Neck</li>
				<li>Shoulders</li>
				<li>Torso</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<tags>
				<li>CFAR_Trooper</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
				<li MayRequire="Ludeon.RimWorld.Odyssey">Spacefarer</li>
			</defaultOutfitTags>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li><only>(255,255,255)</only></li>
			</options>
		</colorGenerator>
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
	    <tradeTags>
			<li>ExoticMisc</li>
			<li>HiTechArmor</li>
			<li>CFAR_Armor</li>
		</tradeTags>
	</ThingDef>
</Defs>