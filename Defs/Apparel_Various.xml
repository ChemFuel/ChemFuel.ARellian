<!--================ Armor ================-->

	<ThingDef ParentName="ArmorHelmetMakeableBase">
		<techLevel>Spacer</techLevel>
		<defName>Apparel_CFAR_HelmetTrooper</defName>
		<label>Arellian trooper helmet</label>
		<description>WIP</description>
		<recipeMaker>
			<displayPriority>1161</displayPriority>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
			<researchPrerequisites>
				<li>ReconArmor</li>
				<li MayRequire="Ludeon.Rimworld.Odyssey">OrbitalTech</li>
			</researchPrerequisites>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<graphicData>
			<texPath>Things/Pawn/Arellian/Apparel/TrooperHelmet/Hat</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.80</drawSize>
		</graphicData>
		<uiIconScale>1.15</uiIconScale>
		<costList>
			<Plasteel>35</Plasteel>
			<ComponentSpacer>1</ComponentSpacer>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<statBases>
			<MarketValue>730</MarketValue>
			<WorkToMake>18000</WorkToMake>
			<Mass>1.5</Mass>
			<MaxHitPoints>210</MaxHitPoints>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>1.00</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
			<ArmorRating_Heat>0.60</ArmorRating_Heat>
			<Insulation_Cold>4</Insulation_Cold>
			<Insulation_Heat>2</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<Terror MayRequire="Ludeon.RimWorld.Ideology">1</Terror>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.68</VacuumResistance>
			<ShootingAccuracyPawn>3</ShootingAccuracyPawn>
			<ToxicEnvironmentResistance>0.80</ToxicEnvironmentResistance>
		</equippedStatOffsets>
		<apparel>
			<wearPerDay>0.01</wearPerDay>
			<developmentalStageFilter>Adult</developmentalStageFilter>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<wornGraphicPath>Things/Pawn/Arellian/Apparel/TrooperHelmet/Hat</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<tags>
				<li>CFAR_Trooper</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
				<li MayRequire="Ludeon.Rimworld.Odyssey">Spacefarer</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li><only>(255,255,255)</only></li>
			</options>
		</colorGenerator>
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
		<tradeTags>
			<li>ExoticMisc</li>
			<li>HiTechArmor</li>
			<li>CFAR_Armor</li>
		</tradeTags>
	</ThingDef>

	<ThingDef ParentName="ArmorMachineableBase">
		<techLevel>Spacer</techLevel>
		<defName>Apparel_CFAR_ArmorTrooper</defName>
