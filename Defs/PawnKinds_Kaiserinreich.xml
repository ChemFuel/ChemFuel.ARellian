<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!--================================ Base - Kaiserinreich ================================-->

	<PawnKindDef Name="CFAR_BaseReichsvolk" Abstract="True">
		<race>Human</race>
		<defaultFactionType>CFAR_Kaiserinreich</defaultFactionType>
		<minTitleRequired MayRequire="Ludeon.Rimworld.Royalty">CFAR_RankA</minTitleRequired>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<combatEnhancingDrugsChance>0</combatEnhancingDrugsChance>
		<combatEnhancingDrugsCount>0~0</combatEnhancingDrugsCount>
		<backstoryCryptosleepCommonality>0.05</backstoryCryptosleepCommonality>
		<useFactionXenotypes>false</useFactionXenotypes>
		<xenotypeSet><xenotypeChances>
			<CFAR_Arellian>999</CFAR_Arellian>
		</xenotypeChances></xenotypeSet>
		<initialResistanceRange>5~10</initialResistanceRange>
		<initialWillRange>0.5~1</initialWillRange>
	</PawnKindDef>

	<PawnKindDef Name="CFAR_BaseSoldier" ParentName="CFAR_BaseReichsvolk" Abstract="True">
		<minGenerationAge>20</minGenerationAge>
		<maxGenerationAge>30</maxGenerationAge>
		<defaultFactionType>CFAR_Kaiserinreich</defaultFactionType>
		<minTitleRequired MayRequire="Ludeon.Rimworld.Royalty">CFAR_RankB</minTitleRequired>
		<gearHealthRange>0.75~1.25</gearHealthRange>
		<apparelMoney>5000~10000</apparelMoney>
		<weaponMoney>200~3000</weaponMoney>
		<apparelTags>
			<li>CFAR_Uniform</li>
		</apparelTags>
		<specificApparelRequirements>
			<li>
				<apparelLayer>OnSkin</apparelLayer>
				<stuff>Synthread</stuff>
			</li>
		</specificApparelRequirements>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<apparelIgnorePollution MayRequire="Ludeon.RimWorld.Biotech">true</apparelIgnorePollution>
		<techHediffsTags>
			<li>Advanced</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<requiredWorkTags>
			<li>Violent</li>
		</requiredWorkTags>
		<disallowedTraits>
			<li>Delicate</li>
		</disallowedTraits>
		<initialResistanceRange>10~20</initialResistanceRange>
		<initialWillRange>1~2</initialWillRange>
	</PawnKindDef>

	<PawnKindDef Name="CFAR_BaseFusilier" ParentName="CFAR_BaseSoldier" Abstract="True">
		<combatPower>150</combatPower>
		<itemQuality>Normal</itemQuality>
		<apparelTags>
			<li>CFAR_Trooper</li>
		</apparelTags>
		<specificApparelRequirements>
			<li>
				<colorGenerator Class="ColorGenerator_Options">
					<options>
						<li><only>(255,255,255)</only></li>
					</options>
				</colorGenerator>
			</li>
		</specificApparelRequirements>
		<techHediffsChance>0.05</techHediffsChance>
		<techHediffsMoney>1000~2500</techHediffsMoney>
		<backstoryFiltersOverride>
			<li>
				<categoriesChildhood>
					<li>CFAR_Reichswehr</li>
				</categoriesChildhood>
				<categoriesAdulthood>
					<li>CFAR_FusilierTrooper</li>
				</categoriesAdulthood>
			</li>
		</backstoryFiltersOverride>
	</PawnKindDef>

	<PawnKindDef Name="CFAR_BaseJager" ParentName="CFAR_BaseSoldier" Abstract="True">
		<combatPower>200</combatPower>
		<itemQuality>Good</itemQuality>
		<apparelTags>
			<li>CFAR_Trooper</li>
			<li>CFAR_VisorCombat</li>
		</apparelTags>
		<specificApparelRequirements>
			<li>
				<colorGenerator Class="ColorGenerator_Options">
					<options>
						<li><only>(50,50,50)</only></li>
					</options>
				</colorGenerator>
			</li>
		</specificApparelRequirements>
		<techHediffsChance>0.05</techHediffsChance>
		<techHediffsMoney>1000~2500</techHediffsMoney>
		<backstoryFiltersOverride>
			<li>
				<categoriesChildhood>
